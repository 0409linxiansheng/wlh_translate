+// frappe-ui renders toolbar labels verbatim and ships them in English; wrap
+// them so the toolbar (including the Heading group and its items) follows the
+// site language. Translations are boot-injected into window.translatedMessages
+// before the bundle runs, so doing it here is safe.
+const __ = (text: string): string =>
+	(window.__ && text ? window.__(text) : text)
+
+function translateItem(item: any) {
+	if (!item || typeof item.label !== 'string') return item
+	if (item.type === 'group') {
+		return {
+			...item,
+			label: __(item.label),
+			items: item.items.map(translateItem),
+		}
+	}
+	return { ...item, label: __(item.label) }
+}
