   type CommandMenuItem,
 } from "frappe-ui/editor";
 import type { MaybeRefOrGetter } from "vue";
 import { CleanStyles, ComponentUtils, HandleExcelPaste } from "@/tiptap-extensions";
+import { __ } from "@/translation";
+
+/**
+ * frappe-ui renders toolbar labels as-is and ships them in English, so a
+ * toolbar built from its atoms stays English. Translate the labels here; the
+ * site translations are injected into `window.translatedMessages` before the
+ * bundle runs, so doing it at module load is safe.
+ */
+function translateItem(item: MenuItem): MenuItem {
+  if ("type" in item && item.type === "group") {
+    const group = item as MenuGroupItem;
+    return {
+      ...group,
+      label: __(group.label),
+      items: group.items.map((sub) => translateItem(sub) as CommandMenuItem),
+    };
+  }
+  if ("label" in item) {
+    return { ...(item as CommandMenuItem), label: __((item as CommandMenuItem).label) };
+  }
+  return item;
+}
+
+function translateItems(items: MenuItem[]): MenuItem[] {
+  return items.map(translateItem);
+}
 
